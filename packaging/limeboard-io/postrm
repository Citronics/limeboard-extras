#!/bin/sh
# SPDX-License-Identifier: MIT
set -e
if [ "$1" = purge ]; then
	if command -v deb-systemd-helper >/dev/null; then
		deb-systemd-helper purge limeboard-config.service >/dev/null || true
	fi
	rm -f /etc/modprobe.d/limeboard.conf /etc/limeboard/config.txt
	rmdir /etc/limeboard 2>/dev/null || true
fi
exit 0
