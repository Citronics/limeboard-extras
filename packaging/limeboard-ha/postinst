#!/bin/sh
# SPDX-License-Identifier: MIT
set -e

if [ "$1" = configure ]; then
	# The settings hold the MQTT password: installed once, root only, and
	# never replaced.
	if [ ! -e /etc/limeboard-ha.conf ]; then
		install -m 0600 /usr/share/limeboard-ha/limeboard-ha.conf /etc/limeboard-ha.conf
	fi

	# The unit images used to install in /etc, where it would hide this
	# package's
	f=/etc/systemd/system/limeboard-ha.service
	if [ -f "$f" ] && [ "$(md5sum < "$f" | cut -d' ' -f1)" = "64bbf0886f65966120bf864d7cf8d22f" ]; then
		rm -f "$f"
	fi

	# The agent is opt-in: an administrator sets up the broker in
	# /etc/limeboard-ha.conf, then enables it. Versions before 1.0.3 (and
	# older images) enabled it themselves: on such an upgrade, it stays
	# enabled only where a broker is configured.
	if [ -z "$2" ] || dpkg --compare-versions "$2" lt 1.0.3; then
		if grep -Eq '^[[:space:]]*MQTT_HOST="?[^"[:space:]]' /etc/limeboard-ha.conf; then
			systemctl enable limeboard-ha.service >/dev/null 2>&1 || true
		else
			systemctl disable limeboard-ha.service >/dev/null 2>&1 || true
			if [ -d /run/systemd/system ]; then
				systemctl stop limeboard-ha.service >/dev/null 2>&1 || true
			fi
		fi
	fi
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		if systemctl is-enabled --quiet limeboard-ha.service; then
			systemctl restart limeboard-ha.service || true
		fi
	fi
fi
exit 0
