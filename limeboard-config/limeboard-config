#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""limeboard-config: set up the Limeboard header, Raspberry Pi style.

    limeboard-config                   apply /etc/limeboard/config.txt
    limeboard-config show              list the settings
    limeboard-config enable ITEM       turn on: i2c1, i2c0, spi0, spi1, serial-console
    limeboard-config disable ITEM      turn off
    limeboard-config firmware          the STM32 firmware: running and shipped versions
    limeboard-config firmware update   flash the shipped firmware when newer (--force: any)
    limeboard-config firmware install [FILE]
                                       replace the board's firmware (e.g. the CircuitPython
                                       it ships with) by the shipped one, or by FILE, a
                                       custom firmware .bin (backup in /var/backups/limeboard)
    limeboard-config ha                the Home Assistant agent (limeboard-ha): on or off, broker
    limeboard-config ha setup          set the MQTT broker, user and password (asked, not
                                       echoed), then turn the agent on; --host H --port P
                                       --user U --password-stdin set them without asking
    limeboard-config ha enable         start the agent now and at every boot
    limeboard-config ha disable        stop it

The buses are off until /etc/limeboard/config.txt turns them on, with the
lines a Raspberry Pi's config.txt uses:

    dtparam=i2c_arm=on        i2c1: SDA GPIO2 (pin 3), SCL GPIO3 (pin 5)
    dtparam=i2c_vc=on         i2c0: SDA GPIO0 (pin 27), SCL GPIO1 (pin 28)
    dtoverlay=i2c0            the same
    dtparam=spi=on            spi0, /dev/spidev0.0 and 0.1
    dtoverlay=spi0-1cs        spi0 with CE0 only (also spi0-2cs)
    dtoverlay=spi1-1cs        spi1, /dev/spidev1.0 (also spi1-2cs, spi1-3cs)

for a kernel driver on a chip select instead of spidev:

    spi0_cs1=mcp3008
    spi1_cs0=mcp2515,irq=25,clock=16000000

the Pi's CAN controller overlays, which do the same:

    dtoverlay=mcp251xfd,spi0-0,interrupt=25      (oscillator=40000000)
    dtoverlay=mcp2515-can0,oscillator=16000000,interrupt=25

and for a login console on the header UART (/dev/serial0, pins 8 and 10):

    serial_console=on

The bus settings go to /etc/modprobe.d/limeboard.conf, as options of the
citronics-dln2 driver, and apply at once: the I2C and SPI ports whose settings
changed are bound again, the GPIO chip and the other ports are left alone.
"""
import os
import re
import subprocess
import sys
import time

CONFIG = "/etc/limeboard/config.txt"
MODPROBE = "/etc/modprobe.d/limeboard.conf"
CONSOLE = "/usr/libexec/limeboard-serial-console"
CONSOLE_SERVICE = "limeboard-serial-console.service"
INITTAB = "/etc/inittab"
FIRMWARE = "/usr/share/limeboard/limeboard-io.bin"
FIRMWARE_VERSION = "/usr/share/limeboard/limeboard-io.version"
USB_ID = ("1209", "0001")       # the Limeboard I/O firmware
MODULE = "citronics_dln2"        # its driver module
DRIVER = "citronics-dln2"        # the prefix of its devices and drivers
DFU_ID = ("0483", "df11")       # the STM32's ROM bootloader
FLASH_SIZE = 512 * 1024         # the STM32F401xE's flash

# Pi name -> Limeboard port, and the chip selects of each SPI port
I2C_PORTS = {"i2c1": 0, "i2c0": 1}
SPI_CHIP_SELECTS = {"spi0": 2, "spi1": 3}
# The line enable writes for each item
ENABLE_LINE = {
    "i2c1": "dtparam=i2c_arm=on",
    "i2c0": "dtoverlay=i2c0",
    "spi0": "dtparam=spi=on",
    "spi1": "dtoverlay=spi1-3cs",
    "serial-console": "serial_console=on",
}
DTPARAMS = {"i2c_arm": "i2c1", "i2c": "i2c1", "i2c1": "i2c1", "i2c_vc": "i2c0",
            "i2c0": "i2c0", "spi": "spi0"}
CS_DEVICE = re.compile(r"^(spi[01])_cs([0-3])$")
# Raspberry Pi overlays for SPI CAN controllers: device, default
# chip select, interrupt GPIO and oscillator, as in the Pi's overlays
CAN_OVERLAYS = {
    "mcp251xfd": ("mcp251xfd", ("spi0", 0), 25, 40000000),
    "mcp2515": ("mcp2515", ("spi0", 0), 25, 16000000),
    "mcp2515-can0": ("mcp2515", ("spi0", 0), 25, 16000000),
    "mcp2515-can1": ("mcp2515", ("spi0", 1), 25, 16000000),
}
ON = ("on", "true", "yes", "1", "")


def warn(message):
    print(f"limeboard-config: {message}", file=sys.stderr)


def read_lines(path=CONFIG):
    try:
        return open(path).read().splitlines()
    except FileNotFoundError:
        return []


def read_config(path=CONFIG):
    return parse(read_lines(path), path)


def parse(lines, path=CONFIG, warn=warn):
    """Return {"i2c": set of Pi names, "spi": {(port, cs): device},
    "serial_console": bool}."""
    config = {"i2c": set(), "spi": {}, "serial_console": False}
    for number, raw in enumerate(lines, 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        key, _, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if key == "dtparam":
            for item in value.split(","):
                name, _, state = item.partition("=")
                bus = DTPARAMS.get(name.strip())
                if bus is None:
                    warn(f"{path}:{number}: unknown dtparam {name.strip()!r}, ignored")
                elif state.strip() in ON:
                    _enable(bus, config)
                else:
                    _disable(bus, config)
        elif key == "dtoverlay":
            overlay = value.split(",")[0].split(":")[0]
            match = re.fullmatch(r"(spi[01])-([123])cs", overlay)
            if overlay in CAN_OVERLAYS:
                chip, problem = can_overlay(overlay, value)
                if problem:
                    warn(f"{path}:{number}: {problem}, ignored")
                else:
                    config["spi"][chip[0]] = chip[1]
            elif overlay == "i2c0":
                config["i2c"].add("i2c0")
            elif match and int(match[2]) <= SPI_CHIP_SELECTS[match[1]]:
                _enable(match[1], config, int(match[2]))
            elif overlay:
                warn(f"{path}:{number}: unknown dtoverlay {overlay!r}, ignored")
        elif CS_DEVICE.match(key):
            port, cs = CS_DEVICE.match(key).groups()
            if int(cs) < SPI_CHIP_SELECTS[port]:
                config["spi"][(port, int(cs))] = value or "none"
            else:
                warn(f"{path}:{number}: {port} has no chip select {cs}, ignored")
        elif key == "serial_console":
            config["serial_console"] = value in ON
        elif key == "enable_uart":
            pass  # the header UART is always there
        else:
            warn(f"{path}:{number}: unknown setting {key!r}, ignored")
    return config


def can_overlay(overlay, value):
    """A CAN controller overlay line -> ((bus, cs), chip select setting).

    dtoverlay=mcp251xfd,spi1-0,interrupt=24,oscillator=40000000 gives
    ("spi1", 0), "mcp251xfd,irq=24,clock=40000000".
    """
    device, (bus, cs), irq, clock = CAN_OVERLAYS[overlay]
    speed = None
    for param in value.replace(":", ",").split(",")[1:]:
        name, _, setting = param.strip().partition("=")
        where = re.fullmatch(r"(spi[01])-([0-3])", name)
        if where:
            bus, cs = where[1], int(where[2])
        elif name == "interrupt" and setting.isdigit():
            irq = int(setting)
        elif name == "oscillator" and setting.isdigit():
            clock = int(setting)
        elif name in ("speed", "spimaxfrequency") and setting.isdigit():
            speed = int(setting)
        elif name:
            return None, f"{overlay}: parameter {name!r} not supported"
    if cs >= SPI_CHIP_SELECTS[bus]:
        return None, f"{bus} has no chip select {cs}"
    if not 0 <= irq <= 27:
        return None, f"interrupt GPIO{irq} is not on the header"
    setting = f"{device},irq={irq},clock={clock}" + (f",speed={speed}" if speed else "")
    return ((bus, cs), setting), None


def _enable(bus, config, chip_selects=None):
    if bus in I2C_PORTS:
        config["i2c"].add(bus)
        return
    for cs in range(chip_selects or SPI_CHIP_SELECTS[bus]):
        config["spi"].setdefault((bus, cs), "spidev")


def _disable(bus, config):
    if bus in I2C_PORTS:
        config["i2c"].discard(bus)
        return
    for cs in range(SPI_CHIP_SELECTS[bus]):
        config["spi"].pop((bus, cs), None)


def driver_options(config):
    """The citronics-dln2 options for the buses of config, in order."""
    ports = sorted(I2C_PORTS[bus] for bus in config["i2c"])
    options = {"i2c_ports": ",".join(map(str, ports)) or "-1"}
    for bus in ("spi0", "spi1"):
        for cs in range(4):
            options[f"{bus}_cs{cs}"] = config["spi"].get((bus, cs), "none")
    return options


def modprobe_options(config):
    options = driver_options(config)
    spi = " ".join(f"{k}={v}" for k, v in options.items() if k != "i2c_ports")
    return (f"# Generated by limeboard-config from {CONFIG}: edit that file.\n"
            f"options {MODULE} i2c_ports={options['i2c_ports']}\n"
            f"options {MODULE} {spi}\n")


def run(*command):
    """Run a command quietly; False when it fails or does not exist."""
    try:
        return subprocess.run(command, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0
    except OSError:
        return False


# Buses -----------------------------------------------------------------------

def apply_buses(config):
    text = modprobe_options(config)
    try:
        old = open(MODPROBE).read()
    except FileNotFoundError:
        old = None
    if text != old:
        os.makedirs(os.path.dirname(MODPROBE), exist_ok=True)
        with open(MODPROBE, "w") as f:
            f.write(text)
    run("udevadm", "control", "--reload")  # for the next load of the module
    parameters = f"/sys/module/{MODULE}/parameters"
    if not os.path.isdir(parameters):
        return
    new = driver_options(config)
    old = {}
    for name, value in new.items():
        with open(f"{parameters}/{name}") as f:
            old[name] = f.read().strip()
        with open(f"{parameters}/{name}", "w") as f:
            f.write(value)
    # The I2C and SPI ports read the options when they bind: bind the ports
    # whose options changed again. A port the options turn off refuses to bind.
    for port in range(2):
        if i2c_port_on(old["i2c_ports"], port) != i2c_port_on(new["i2c_ports"], port):
            rebind(f"{DRIVER}-i2c", port)
        if any(old[f"spi{port}_cs{cs}"] != new[f"spi{port}_cs{cs}"] for cs in range(4)):
            rebind(f"{DRIVER}-spi", port)


def i2c_port_on(i2c_ports, port):
    """Whether the i2c_ports option adds I2C port `port`: all when empty."""
    return not i2c_ports or str(port) in i2c_ports.split(",")


def rebind(driver, port):
    """Bind the device of a port of the driver again. The devices of an
    adapter's ports are numbered in port order: <driver>.<id>.auto."""
    devices = sorted((d for d in os.listdir("/sys/bus/platform/devices")
                      if d.startswith(driver + ".")),
                     key=lambda d: int(d.split(".")[1]))
    if port >= len(devices):
        return
    sysfs = f"/sys/bus/platform/drivers/{driver}"
    if os.path.exists(f"{sysfs}/{devices[port]}"):
        write_quietly(f"{sysfs}/unbind", devices[port])
    write_quietly(f"{sysfs}/bind", devices[port])


def write_quietly(path, text):
    """Write a sysfs file; False when the kernel refuses."""
    try:
        with open(path, "w") as f:
            f.write(text)
        return True
    except OSError:
        return False


# Serial console ----------------------------------------------------------------

def apply_serial_console(on):
    """A login console on /dev/serial0: a systemd service, or a busybox
    inittab line, both running CONSOLE."""
    if os.path.isdir("/run/systemd/system"):
        run("systemctl", "enable" if on else "disable", "--now", CONSOLE_SERVICE)
        return
    if not os.path.exists(INITTAB):
        warn("no systemd and no inittab: start the serial console by hand")
        return
    line = f"::respawn:{CONSOLE}"
    lines = read_lines(INITTAB)
    present = line in lines
    if on == present:
        return
    lines = lines + [line] if on else [l for l in lines if l != line]
    with open(INITTAB, "w") as f:
        f.write("\n".join(lines) + "\n")
    # busybox init rereads inittab: it starts a new entry and stops the
    # processes of a removed one
    run("kill", "-HUP", "1")


# Firmware ------------------------------------------------------------------------

def usb_device(ids):
    """The sysfs directory of the USB device with these (vendor, product) ids."""
    base = "/sys/bus/usb/devices"
    for name in sorted(os.listdir(base)):
        try:
            vendor = open(f"{base}/{name}/idVendor").read().strip()
            product = open(f"{base}/{name}/idProduct").read().strip()
        except OSError:
            continue
        if (vendor, product) == ids:
            return f"{base}/{name}"
    return None


def running_version():
    device = usb_device(USB_ID)
    if device is None:
        return None
    bcd = open(f"{device}/bcdDevice").read().strip()  # e.g. "0101"
    return f"{int(bcd[:2])}.{int(bcd[2:])}"


def shipped_version():
    try:
        return open(FIRMWARE_VERSION).read().strip()
    except OSError:
        return None


def wait_for(ids, seconds):
    for _ in range(seconds * 10):
        if usb_device(ids):
            return True
        time.sleep(0.1)
    return False


def version_tuple(version):
    return tuple(int(part) for part in version.split("."))


def other_firmware():
    """The sysfs directory of a Limeboard STM32 running other firmware, such
    as the CircuitPython it ships with, recognised by its product name."""
    base = "/sys/bus/usb/devices"
    for name in sorted(os.listdir(base)):
        try:
            ids = (open(f"{base}/{name}/idVendor").read().strip(),
                   open(f"{base}/{name}/idProduct").read().strip())
            product = open(f"{base}/{name}/product").read().strip()
        except OSError:
            continue
        if "Limeboard" in product and ids not in (USB_ID, DFU_ID):
            return f"{base}/{name}"
    return None


def device_nodes(device, kind):
    """The /dev nodes of a USB device's serial ports ("tty") or disks
    ("block")."""
    nodes = []
    for root, dirs, _ in os.walk(device):
        if os.path.basename(root) == kind:
            nodes += [f"/dev/{d}" for d in dirs]
            dirs.clear()
    return sorted(nodes)


def circuitpython_to_bootloader(tty):
    """Interrupt CircuitPython on its REPL and reset it into the STM32's ROM
    bootloader. False when no REPL prompt answered."""
    import select
    import termios
    fd = os.open(tty, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    attrs = termios.tcgetattr(fd)
    attrs[0] = attrs[1] = attrs[3] = 0
    attrs[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
    attrs[4] = attrs[5] = termios.B115200
    termios.tcsetattr(fd, termios.TCSANOW, attrs)

    def read(seconds, until=None):
        out = b""
        end = time.time() + seconds
        while time.time() < end and not (until and until in out):
            if select.select([fd], [], [], 0.1)[0]:
                try:
                    out += os.read(fd, 4096)
                except OSError:
                    break
        return out

    try:
        for _ in range(3):
            os.write(fd, b"\x03\x03")  # stop code.py
            out = read(2, b">>> ")
            if b">>> " not in out:
                os.write(fd, b"\r")  # "Press any key to enter the REPL"
                out += read(2, b">>> ")
            if b">>> " in out:
                break
        else:
            return False
        for line in (b"import microcontroller\r",
                     b"microcontroller.on_next_reset(microcontroller.RunMode.BOOTLOADER)\r"):
            os.write(fd, line)
            read(2, b">>> ")
        os.write(fd, b"microcontroller.reset()\r")
        read(1)
    except OSError:
        pass  # the reset closes the port
    finally:
        try:
            os.close(fd)
        except OSError:
            pass
    return True


def backup_files(device, backup):
    """Copy the files of the device's drive (CIRCUITPY) to backup."""
    for disk in device_nodes(device, "block"):
        for part in (f"{disk}1", disk):
            if not os.path.exists(part):
                continue
            mnt = f"/run/limeboard-backup-{os.getpid()}"
            os.makedirs(mnt, exist_ok=True)
            if run("mount", "-o", "ro", part, mnt):
                try:
                    return run("cp", "-a", f"{mnt}/.", f"{backup}/files")
                finally:
                    run("umount", mnt)
                    os.rmdir(mnt)
            os.rmdir(mnt)
    return False


def flash_firmware(image, name):
    """Flash image from the bootloader; for the Limeboard I/O firmware, wait
    until it runs."""
    print(f"flashing {name}...")
    result = subprocess.run(["dfu-util", "-d", ":".join(DFU_ID), "-a", "0",
                             "-s", "0x08000000:leave", "-D", image],
                            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if image != FIRMWARE:
        if result.returncode != 0 and usb_device(DFU_ID):
            sys.exit(f"limeboard-config: dfu-util failed:\n{result.stderr.strip()}")
        print(f"flashed {name}; to go back: sudo limeboard-config firmware install")
        return
    if result.returncode != 0 and not wait_for(USB_ID, 1):
        sys.exit(f"limeboard-config: dfu-util failed:\n{result.stderr.strip()}")
    if not wait_for(USB_ID, 15):
        sys.exit("limeboard-config: the firmware did not start; hold the user button "
                 "while powering the board to reach the bootloader, then run this again")
    print(f"running: {running_version()}")


def firmware(command=None, force=False, auto=False, image=None):
    running, shipped = running_version(), shipped_version()
    in_bootloader = usb_device(DFU_ID) is not None
    other = None if running or in_bootloader else other_firmware()
    if not auto:
        if other:
            product = open(f"{other}/product").read().strip()
            print(f"running: other firmware ({product}); 'limeboard-config firmware install' "
                  "replaces it")
        else:
            print(f"running: {running or ('none: the STM32 is in its bootloader' if in_bootloader else 'none')}")
        print(f"shipped: {shipped or 'none'} ({FIRMWARE})")
    if command is None:
        return
    if shipped is None or not os.path.exists(FIRMWARE):
        sys.exit("limeboard-config: no firmware to flash")

    if command == "update":
        # The Limeboard I/O firmware only; never an older version unless forced
        if auto and (running is None or version_tuple(running) >= version_tuple(shipped)):
            return
        if not running and not in_bootloader:
            sys.exit("limeboard-config: the Limeboard I/O firmware is not running"
                     + ("; 'limeboard-config firmware install' replaces the board's firmware"
                        if other else " (no Limeboard found on USB)"))
        if running and not force:
            if version_tuple(running) == version_tuple(shipped):
                print("already up to date (--force flashes anyway)")
                return
            if version_tuple(running) > version_tuple(shipped):
                sys.exit(f"limeboard-config: the running {running} is newer than the shipped "
                         f"{shipped} (--force installs {shipped})")
        if not in_bootloader:
            print("restarting the STM32 into its bootloader...")
            run("dfu-util", "-d", ":".join(USB_ID), "-e")
            if not wait_for(DFU_ID, 10):
                sys.exit("limeboard-config: the bootloader did not appear")
        flash_firmware(FIRMWARE, shipped)
        return

    # install: replace whatever the STM32 runs (the Limeboard I/O firmware, the
    # CircuitPython it ships with, the bootloader) with the shipped firmware or
    # with image, a custom firmware file
    if image is not None:
        if not os.path.isfile(image):
            sys.exit(f"limeboard-config: {image}: no such file")
        if os.path.getsize(image) > FLASH_SIZE:
            sys.exit(f"limeboard-config: {image} is larger than the STM32's flash "
                     f"({FLASH_SIZE // 1024} KiB)")
    elif running:
        return firmware("update", force=force)
    backup = f"/var/backups/limeboard/{time.strftime('%Y%m%d-%H%M%S')}"
    os.makedirs(backup, exist_ok=True)
    if running:
        print("restarting the STM32 into its bootloader...")
        run("dfu-util", "-d", ":".join(USB_ID), "-e")
        if not wait_for(DFU_ID, 10):
            sys.exit("limeboard-config: the bootloader did not appear")
    elif other:
        if backup_files(other, backup):
            print(f"saved the board's files in {backup}/files")
        ttys = device_nodes(other, "tty")
        if not ttys:
            sys.exit("limeboard-config: no serial port to reach the board's firmware; hold the "
                     "user button while powering the board, then run this again")
        print("restarting the STM32 into its bootloader...")
        if not circuitpython_to_bootloader(ttys[0]):
            sys.exit("limeboard-config: the board's firmware did not answer on its serial "
                     "port; hold the user button while powering the board, then run this again")
        if not wait_for(DFU_ID, 15):
            sys.exit("limeboard-config: the bootloader did not appear; hold the user button "
                     "while powering the board, then run this again")
    elif not in_bootloader:
        sys.exit("limeboard-config: no Limeboard found on USB")
    # The whole flash, to put the previous firmware back with
    # sudo limeboard-config firmware install <backup>/flash.bin
    if run("dfu-util", "-d", ":".join(DFU_ID), "-a", "0", "-s", f"0x08000000:{FLASH_SIZE}",
           "-U", f"{backup}/flash.bin"):
        print(f"saved the previous firmware in {backup}/flash.bin")
    if image is None:
        flash_firmware(FIRMWARE, shipped)
    else:
        flash_firmware(os.path.abspath(image), os.path.basename(image))


# Commands ------------------------------------------------------------------------

def apply(config):
    apply_buses(config)
    apply_serial_console(config["serial_console"])


def show(config):
    for bus in I2C_PORTS:
        print(f"{bus}: {'on' if bus in config['i2c'] else 'off'}")
    for bus, count in SPI_CHIP_SELECTS.items():
        devices = [config["spi"].get((bus, cs)) for cs in range(count)]
        if any(devices):
            print(f"{bus}: on, " + ", ".join(f"CE{cs} {d}" for cs, d in enumerate(devices) if d))
        else:
            print(f"{bus}: off")
    print(f"serial-console: {'on' if config['serial_console'] else 'off'} (/dev/serial0)")
    print(f"firmware: {running_version() or 'not running'}")


def items(config):
    found = set(config["i2c"]) | {bus for bus, _ in config["spi"]}
    if config["serial_console"]:
        found.add("serial-console")
    return found


def edit(item, on):
    """Remove the lines that turn only this item on, then add its line for on."""
    quiet = lambda message: None
    kept = [raw for raw in read_lines()
            if items(parse([raw], warn=quiet)) != {item}]
    if on:
        kept.append(ENABLE_LINE[item])
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w") as f:
        f.write("\n".join(kept) + "\n")
    if not on and item in items(read_config()):
        warn(f"a line of {CONFIG} turns {item} on with other buses: edit it")


# Home Assistant agent ------------------------------------------------------------

HA_CONF = "/etc/limeboard-ha.conf"
HA_DEFAULT = "/etc/default/limeboard-ha"   # Buildroot: ENABLED=yes starts the agent
HA_SERVICE = "limeboard-ha.service"
HA_INIT = "/etc/init.d/S95limeboard-ha"
HA_KEYS = ("MQTT_HOST", "MQTT_PORT", "MQTT_USER", "MQTT_PASSWORD")


def ha_installed():
    return os.path.exists("/usr/bin/limeboard-ha")


def ha_systemd():
    return os.path.isdir("/run/systemd/system")


def ha_read():
    """The agent's settings, parsed the way limeboard-ha parses them."""
    conf = {}
    for line in read_lines(HA_CONF):
        if "=" in line and not line.lstrip().startswith("#"):
            key, value = line.strip().split("=", 1)
            conf[key] = value.strip("'\"")
    return conf


def ha_write(updates):
    """Replace or add KEY="value" lines; the file stays readable by root only."""
    for key, value in updates.items():
        if "\n" in value or value[:1] in "'\"" and value or value[-1:] in "'\"" and value:
            sys.exit(f"limeboard-config: {key} cannot contain a line break or start or "
                     "end with a quote")
    lines, done = read_lines(HA_CONF), set()
    for i, line in enumerate(lines):
        key = line.split("=", 1)[0].strip()
        if "=" in line and not line.lstrip().startswith("#") and key in updates:
            lines[i] = f'{key}="{updates[key]}"'
            done.add(key)
    lines += [f'{key}="{value}"' for key, value in updates.items() if key not in done]
    tmp = HA_CONF + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, HA_CONF)


def ha_enabled():
    if ha_systemd():
        return run("systemctl", "is-enabled", "--quiet", HA_SERVICE)
    return any(re.match(r'\s*ENABLED="?yes"?\s*$', line) for line in read_lines(HA_DEFAULT))


def ha_running():
    if ha_systemd():
        return run("systemctl", "is-active", "--quiet", HA_SERVICE)
    pid = read_lines("/var/run/limeboard-ha.pid")
    return bool(pid) and os.path.exists(f"/proc/{pid[0].strip()}")


def ha_set(on):
    """Turn the agent on (and restart it, for new settings) or off, now and at boot."""
    if ha_systemd():
        if on:
            run("systemctl", "enable", HA_SERVICE)
            ok = run("systemctl", "restart", HA_SERVICE)
        else:
            ok = run("systemctl", "disable", "--now", HA_SERVICE)
    else:
        lines = [l for l in read_lines(HA_DEFAULT) if not re.match(r"\s*ENABLED=", l)]
        lines.append(f"ENABLED={'yes' if on else 'no'}")
        with open(HA_DEFAULT, "w") as f:
            f.write("\n".join(lines) + "\n")
        ok = run(HA_INIT, "restart" if on else "stop")
    if not ok:
        warn(f"could not {'start' if on else 'stop'} the agent")


def ha_show():
    if not ha_installed():
        print("limeboard-ha: not installed")
        return
    conf = ha_read() if os.access(HA_CONF, os.R_OK) else None
    state = "on" if ha_enabled() else "off (opt-in: limeboard-config ha setup)"
    print(f"agent: {state}, {'running' if ha_running() else 'not running'}")
    if conf is None:
        print(f"broker: {HA_CONF} is readable by root only (use sudo)")
        return
    host = conf.get("MQTT_HOST", "")
    if host:
        user = conf.get("MQTT_USER", "")
        print(f"broker: {user + '@' if user else ''}{host}:{conf.get('MQTT_PORT', '1883')}, "
              f"password {'set' if conf.get('MQTT_PASSWORD') else 'not set'}")
    else:
        print("broker: not set")


def ha_setup(options):
    conf = ha_read()
    updates = {}
    flags = {"--host": "MQTT_HOST", "--port": "MQTT_PORT", "--user": "MQTT_USER"}
    stdin_password = "--password-stdin" in options
    options = [o for o in options if o != "--password-stdin"]
    if len(options) % 2 or any(o not in flags for o in options[::2]):
        sys.exit(__doc__.split("\n\n")[1])
    for flag, value in zip(options[::2], options[1::2]):
        updates[flags[flag]] = value
    if stdin_password:
        updates["MQTT_PASSWORD"] = sys.stdin.readline().rstrip("\n")
    elif not options:
        import getpass
        for key, label in (("MQTT_HOST", "Broker host"), ("MQTT_PORT", "Broker port"),
                           ("MQTT_USER", "User")):
            current = conf.get(key, "")
            answer = input(f"{label} [{current}]: ").strip()
            if answer:
                updates[key] = answer
        password = getpass.getpass("Password (empty keeps the current one): ")
        if password:
            updates["MQTT_PASSWORD"] = password
    if "MQTT_PORT" in updates and not updates["MQTT_PORT"].isdigit():
        sys.exit("limeboard-config: the port must be a number")
    if updates:
        ha_write(updates)
    if not ha_read().get("MQTT_HOST"):
        sys.exit("limeboard-config: no broker host set; the agent stays off")
    ha_set(True)
    ha_show()


def ha(args):
    if not ha_installed():
        sys.exit("limeboard-config: limeboard-ha is not installed")
    if args and os.geteuid() != 0:
        sys.exit("limeboard-config: run it with sudo")
    if not args:
        ha_show()
    elif args[0] == "setup":
        ha_setup(args[1:])
    elif args in (["enable"], ["disable"]):
        if args == ["enable"] and not ha_read().get("MQTT_HOST"):
            warn("no broker host set: the agent stays idle (limeboard-config ha setup)")
        ha_set(args == ["enable"])
        ha_show()
    else:
        sys.exit(__doc__.split("\n\n")[1])


def main(argv):
    args = argv[1:]
    if not args:
        apply(read_config())
    elif args == ["show"]:
        show(read_config())
    elif len(args) == 2 and args[0] in ("enable", "disable") and args[1] in ENABLE_LINE:
        edit(args[1], args[0] == "enable")
        config = read_config()
        apply(config)
        show(config)
    elif args[:1] == ["firmware"] and args[1:] in (
            [], ["update"], ["update", "--force"], ["update", "--auto"], ["install"]):
        firmware(args[1] if len(args) > 1 else None, force="--force" in args,
                 auto="--auto" in args)
    elif args[:2] == ["firmware", "install"] and len(args) == 3:
        firmware("install", image=args[2])
    elif args[:1] == ["ha"]:
        ha(args[1:])
    else:
        sys.exit(__doc__.split("\n\n")[1])


if __name__ == "__main__":
    main(sys.argv)
